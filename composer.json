    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.8",
        "avisitor/env-loader": "^1.0",
        "avisitor/mailprovider": "^0.2",
        "avisitor/mailserviceclient": "^1.4"
    },
    "autoload": {
        "files": [
            "envloader.php"
        ]
    },
